@account_service = http://localhost:8000
@product_service = http://localhost:8001
@order_service = http://localhost:8002

# Existing clients in account_service DB (must exist before running order tests)
@client_1_id =2545ed5c-2a1d-4e15-ae37-c43bcada67bf
@client_2_id = 80eb2c2a-726b-4360-8068-6ed386f95f9f
@client_3_id = 33333333-3333-3333-3333-333333333333
@client_4_id = 44444444-4444-4444-4444-444444444444
@client_5_id = 55555555-5555-5555-5555-555555555555

### ACCOUNT SERVICE

### Health
GET {{account_service}}/health/ HTTP/1.1

### Register user 1
# @name registerUser1
POST {{account_service}}/auth/register/ HTTP/1.1
Content-Type: application/json

{
    "email": "admin@gmail.com",
    "username": "admin",
    "password": "admin1234"
}

### Register user 2
# @name registerUser2
POST {{account_service}}/auth/register/ HTTP/1.1
Content-Type: application/json

{
    "email": "user2.e2e@gmail.com",
    "username": "user2_e2e",
    "password": "User2Pass123"
}

### Register user 3
# @name registerUser3
POST {{account_service}}/auth/register/ HTTP/1.1
Content-Type: application/json

{
    "email": "user3.e2e@gmail.com",
    "username": "user3_e2e",
    "password": "User3Pass123"
}

### Login with user 1 and capture JWT
# @name loginUser1
POST {{account_service}}/auth/login/ HTTP/1.1
Content-Type: application/json

{
    "email": "user1.e2e@gmail.com",
    "password": "User1Pass123"
}

### Verify access token
POST {{account_service}}/auth/verify/ HTTP/1.1
Content-Type: application/json

{
    "token": "{{loginUser1.response.body.$.access}}"
}

### Me (user 1)
GET {{account_service}}/auth/me/ HTTP/1.1
Authorization: Bearer {{loginUser1.response.body.$.access}}

### User details for all 3 users
GET {{account_service}}/user/me/{{registerUser1.response.body.$.user.id}}/ HTTP/1.1
Authorization: Bearer {{loginUser1.response.body.$.access}}

GET {{account_service}}/user/me/{{registerUser2.response.body.$.user.id}}/ HTTP/1.1
Authorization: Bearer {{loginUser1.response.body.$.access}}

GET {{account_service}}/user/me/{{registerUser3.response.body.$.user.id}}/ HTTP/1.1
Authorization: Bearer {{loginUser1.response.body.$.access}}
###
GET {{account_service}}/customers/ HTTP/1.1
Authorization: Bearer {{loginUser1.response.body.$.access}}


