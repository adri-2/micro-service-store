GET {{order_service}}/orders/{{createOrder8.response.body.$.id}}/ HTTP/1.1
Authorization: Bearer {{loginUser1.response.body.$.access}}

### Negative cases
### Invalid product payload: price must be > 0
POST {{product_service}}/products/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{loginUser1.response.body.$.access}}

{
    "name": "Invalid Product",
    "price": "0",
    "description": "Should fail",
    "category": "{{createCategory1.response.body.$.id}}",
    "suppliers": "{{createSupplier1.response.body.$.id}}",
    "stock": 1
}

### Invalid order payload: empty items_input
POST {{order_service}}/orders/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{loginUser1.response.body.$.access}}

{
    "user_id": "{{registerUser1.response.body.$.user.id}}",
    "client_id": "{{client_1_id}}",
    "items_input": []
}

### Invalid order payload: quantity must be >= 1
POST {{order_service}}/orders/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{loginUser1.response.body.$.access}}

{
    "user_id": "{{registerUser2.response.body.$.user.id}}",
    "client_id": "{{client_2_id}}",
    "items_input": [
        {
            "product_id": "{{createProduct1.response.body.$.id}}",
            "quantity": 0
        }
    ]
}