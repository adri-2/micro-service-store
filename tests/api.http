@account_service = http://localhost:8000
@product_service = http://localhost:8001
@order_service = http://localhost:8002

# Change these values if your seeded user is different.
@login_email = admin@gmail.com
@login_password = admin1234

# client_id is required by order-service model. Keep a valid UUID format.
@client_id = 11111111-1111-1111-1111-111111111111

### ACCOUNT SERVICE

### Health
GET {{account_service}}/health/ HTTP/1.1

### Login and capture JWT/user
# @name login
POST {{account_service}}/auth/login/ HTTP/1.1
Content-Type: application/json

{
    "email": "{{login_email}}",
    "password": "{{login_password}}"
}

### Verify access token
POST {{account_service}}/auth/verify/ HTTP/1.1
Content-Type: application/json

{
    "token": "{{login.response.body.$.access}}"
}

### Me
GET {{account_service}}/auth/me/ HTTP/1.1
Authorization: Bearer {{login.response.body.$.access}}

### User detail (used by order-service integration)
GET {{account_service}}/user/me/{{login.response.body.$.user.id}}/ HTTP/1.1
Authorization: Bearer {{login.response.body.$.access}}

### PRODUCT SERVICE

### Health
GET {{product_service}}/health/ HTTP/1.1

### List categories
GET {{product_service}}/categories/ HTTP/1.1
Authorization: Bearer {{login.response.body.$.access}}

### Create category
# @name createCategory
POST {{product_service}}/categories/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.access}}

{
    "name": "Electronics",
    "description": "Devices, consoles and accessories"
}

### Create supplier
# @name createSupplier
POST {{product_service}}/suppliers/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.access}}

{
    "name": "Sony",
    "contact_name": "Support Team",
    "email": "contact@sony.com",
    "phone_number": "+33100000000",
    "address": "1-7-1 Konan, Minato-ku, Tokyo"
}

### Create product
# @name createProduct
POST {{product_service}}/products/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.access}}

{
    "name": "PlayStation 5",
    "price": "499.99",
    "description": "Console de test",
    "category": "{{createCategory.response.body.$.id}}",
    "suppliers": "{{createSupplier.response.body.$.id}}",
    "stock": 10
}

### List products
GET {{product_service}}/products/ HTTP/1.1
Authorization: Bearer {{login.response.body.$.access}}

### Get one product
GET {{product_service}}/products/{{createProduct.response.body.$.id}}/ HTTP/1.1
Authorization: Bearer {{login.response.body.$.access}}

### Invalid product payload: price must be > 0
POST {{product_service}}/products/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.access}}

{
    "name": "Invalid Product",
    "price": "0",
    "description": "Should fail",
    "category": "{{createCategory.response.body.$.id}}",
    "suppliers": "{{createSupplier.response.body.$.id}}",
    "stock": 1
}

### ORDER SERVICE

### Health
GET {{order_service}}/health/ HTTP/1.1

### Create order
# @name createOrder
POST {{order_service}}/orders/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.access}}

{
    "user_id": "{{login.response.body.$.user.id}}",
    "client_id": "{{client_id}}",
    "items_input": [
        {
            "product_id": "{{createProduct.response.body.$.id}}",
            "quantity": 2
        }
    ]
}

### List orders
GET {{order_service}}/orders/ HTTP/1.1
Authorization: Bearer {{login.response.body.$.access}}

### Get one order
GET {{order_service}}/orders/{{createOrder.response.body.$.id}}/ HTTP/1.1
Authorization: Bearer {{login.response.body.$.access}}

### Confirm order
POST {{order_service}}/orders/{{createOrder.response.body.$.id}}/confirm/ HTTP/1.1
Authorization: Bearer {{login.response.body.$.access}}

### Invalid order payload: empty items_input
POST {{order_service}}/orders/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.access}}

{
    "user_id": "{{login.response.body.$.user.id}}",
    "client_id": "{{client_id}}",
    "items_input": []
}

### Invalid order payload: quantity must be >= 1
POST {{order_service}}/orders/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.access}}

{
    "user_id": "{{login.response.body.$.user.id}}",
    "client_id": "{{client_id}}",
    "items_input": [
        {
            "product_id": "{{createProduct.response.body.$.id}}",
            "quantity": 0
        }
    ]
}