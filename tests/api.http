### Create 10 orders
# @name createOrder1
POST {{order_service}}/orders/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{loginUser1.response.body.$.access}}

{
    "user_id": "{{registerUser1.response.body.$.user.id}}",
    "client_id": "{{client_1_id}}",
    "items_input": [
        { "product_id": "{{createProduct1.response.body.$.id}}", "quantity": 1 },
        { "product_id": "{{createProduct2.response.body.$.id}}", "quantity": 2 }
    ]
}

